# --- Required ---

# OpenAI API key — powers all four agents (query planning, summarization,
# fact-checking, writing).
OPENAI_API_KEY=

# Tavily API key — web search for the Search agent. Free tier: 1000
# searches/month at https://tavily.com
TAVILY_API_KEY=

# --- Optional ---

# Chat model (default: gpt-4o-mini)
OPENAI_MODEL=
